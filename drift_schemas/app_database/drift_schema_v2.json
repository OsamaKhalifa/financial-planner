          "sql": "CREATE TABLE IF NOT EXISTS \"investments\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"asset_type\" TEXT NOT NULL, \"intent\" TEXT NULL, \"market\" TEXT NULL, \"market_country\" TEXT NULL, \"unit\" TEXT NOT NULL, \"start_date\" TEXT NOT NULL, \"quantity\" TEXT NULL, \"purity_karat\" INTEGER NULL, \"purity_fineness\" INTEGER NULL, \"zakat_rule\" TEXT NOT NULL, \"custom_zakat_share\" TEXT NULL, \"inflation_override\" TEXT NULL, \"notes\" TEXT NULL, \"payout_schedule\" TEXT NULL, \"expected_profit\" TEXT NULL, \"value_check_schedule\" TEXT NULL, \"expected_growth\" TEXT NULL, \"profit_basis\" TEXT NULL, \"capital_back\" TEXT NULL, \"account_kind\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
